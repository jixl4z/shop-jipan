generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String?  @unique
  password  String?
  role      String   @default("USER") // "USER" | "ADMIN"
  balance   Float    @default(0.0)
  avatar    String?
  discordId String?  @unique
  googleId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
  topups TopupTransaction[]
  reviews Review[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  icon        String?   @default("Package")
  description String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  products Product[]
}

model Product {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  description   String?
  price         Float
  originalPrice Float?
  image         String
  badge         String?
  isActive      Boolean         @default(true)
  isSuspended   Boolean         @default(false)
  isRecommended Boolean         @default(false)
  hasVariants   Boolean         @default(false) // มีตัวเลือกย่อยหรือไม่
  categoryId    String
  category      Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  options       ProductOption[]
  stockItems    StockItem[]
  orders        Order[]
}

model ProductOption {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String      // e.g. "1 วัน", "7 วัน", "30 วัน", "ถาวร"
  price         Float
  originalPrice Float?
  badge         String?     // e.g. "🌸"
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  stockItems    StockItem[]
}

model StockItem {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionId  String?
  option    ProductOption?  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  content   String    // รหัสคีย์ / บัญชี:รหัสผ่าน / ลิงก์ดาวน์โหลด
  isUsed    Boolean   @default(false)
  orderId   String?
  order     Order?    @relation(fields: [orderId], references: [id])
  createdAt DateTime  @default(now())
  usedAt    DateTime?
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId      String
  product        Product     @relation(fields: [productId], references: [id])
  productName    String
  optionName     String?     // ชื่อตัวเลือกที่สั่งซื้อ (ถ้ามี)
  price          Float
  quantity       Int         @default(1)
  discountAmount Float       @default(0)
  couponCode     String?
  totalAmount    Float
  deliveredData  String      // ข้อมูลสินค้าที่ส่งมอบ (กุญแจ/รหัส)
  status         String      @default("COMPLETED")
  createdAt      DateTime    @default(now())

  stockItems     StockItem[]
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  title          String    // e.g. "ลดพิเศษ 10%"
  description    String?   // e.g. "ลด 10% (สูงสุด 50 บาท)"
  discountType   String    @default("PERCENT") // "PERCENT" | "FIXED"
  discountValue  Float     // e.g. 10 (%) หรือ 50 (บาท)
  minSpend       Float     @default(0)
  maxDiscount    Float?    // สูงสุดกี่บาท
  usageLimit     Int?      // จำนวนครั้งทั้งหมดที่ใช้ได้ (null = ไม่จำกัด)
  usedCount      Int       @default(0)
  productId      String?   // ผูกเฉพาะสินค้า (null = ทุกสินค้า)
  isActive       Boolean   @default(true)
  expiresAt      DateTime? // หมดอายุ
  createdAt      DateTime  @default(now())
}

model TopupTransaction {
  id            String    @id @default(cuid())
  transactionId String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String    @default("SLIP") // "SLIP" | "TRUEMONEY"
  amount        Float
  slipImage     String?
  transRef      String?   @unique // รหัสอ้างอิงสลิป หรือ voucher hash
  senderName    String?
  bank          String?
  status        String    @default("PENDING") // "PENDING" | "SUCCESS" | "REJECTED"
  rawPayload    String?
  createdAt     DateTime  @default(now())
}

model ShopSetting {
  id              String   @id @default("default")
  shopName        String   @default("JIPAN STORE")
  shopSlogan      String   @default("ร้านค้าไอดีเกมและบริการดิจิทัลอัตโนมัติ 24 ชม.")
  shopNotice      String   @default("ยินดีต้อนรับสู่ร้านค้า! เติมเงินผ่านระบบตรวจสอบสลิปอัตโนมัติ & ทรูวอเล็ท รับของทันที 24 ชม.")
  logoUrl         String?  @default("/logo.png")
  bannerUrls      String   @default("[]")
  themeColor      String   @default("monochrome") // "monochrome", "purple", "emerald", "blue", "crimson", "amber"
  themeMode       String   @default("dark")
  promptPayNumber String   @default("0812345678")
  promptPayName   String   @default("พร้อมเพย์ร้านค้า")
  truemoneyNumber String?  @default("") // เบอร์โทรรับซองอั่งเปา TrueMoney Wallet
  slipApiKey      String?  @default("SLIPOKC43QGIC")
  slipApiBranch   String?  @default("78463")
  slipProvider    String   @default("slipok") // "slipok", "easyslip", "openslipcheck", "simulation"
  turnstileEnabled Boolean  @default(false)
  turnstileSiteKey String?  @default("")
  turnstileSecretKey String? @default("")
  discordWebhookUrl String?  @default("")
  discordClientId   String?  @default("")
  discordClientSecret String? @default("")
  googleClientId    String?  @default("")
  googleClientSecret String? @default("")
  contactDiscord  String?  @default("https://discord.gg/")
  contactFacebook String?  @default("https://facebook.com/")
  contactLine     String?  @default("https://line.me/ti/p/")
  discordServerId String?  @default("")
  popupEnabled    Boolean  @default(false)
  popupTitle      String?  @default("ข่าวสารและกิจกรรม")
  popupMediaUrl   String?  @default("")
  popupMediaType  String?  @default("auto") // "auto", "image", "video"
  popupLink       String?  @default("")
  popupLinkText   String?  @default("เปิดลิงก์")
  updatedAt       DateTime @updatedAt
}

model Review {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating      Int      @default(5)
  comment     String
  productName String?
  createdAt   DateTime @default(now())
}
