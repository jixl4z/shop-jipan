# Supabase PostgreSQL Pooler Database
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Authentication Secret (Use at least 32 random characters)
JWT_SECRET="replace_with_64_char_random_hex_secret"

# Public App URL (Port 4500)
NEXT_PUBLIC_BASE_URL="http://localhost:4500"

# SlipOK API Credentials (Optional fallback if not set in Admin DB)
SLIPOK_BRANCH_ID=""
SLIPOK_API_KEY=""
